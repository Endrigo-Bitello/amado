# =============================================================================
# CRM Amado & Amado Jr. — variáveis de ambiente (modelo; NÃO coloque valores reais aqui)
# Copie para .env.local (desenvolvimento) ou cadastre no painel da Vercel (produção).
# =============================================================================

# --- Site/CRM (Next.js) — chegam ao navegador, são públicas por natureza ------
# Supabase → Project Settings → API → Project URL
NEXT_PUBLIC_SUPABASE_URL=
# Supabase → Project Settings → API Keys → "Publishable key" (ou a antiga "anon public")
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Alternativa aceita no lugar da anterior (chave "anon" legada):
# NEXT_PUBLIC_SUPABASE_ANON_KEY=

# --- Encaminhamento legado do quiz para o Monday (opcional, só no servidor) ---
# Sem estas duas variáveis nada é enviado ao Monday; o CRM continua recebendo os leads.
MONDAY_API_KEY=
MONDAY_BOARD_ID=

# =============================================================================
# Segredos das Edge Functions (NÃO vão para a Vercel). Cadastre com:
#   npx supabase secrets set --project-ref <ref> CRM_ORIGENS_PERMITIDAS=... CRM_SITE_URL=... CRM_SAL_HASH=...
# SUPABASE_URL e SUPABASE_SERVICE_ROLE_KEY já são fornecidas automaticamente às funções.
# =============================================================================
# Origens autorizadas a chamar o quiz e o portal de documentos (separadas por vírgula):
# CRM_ORIGENS_PERMITIDAS=https://amadoeamadojr.com.br,https://www.amadoeamadojr.com.br
# Endereço público usado nos links de envio de documentos:
# CRM_SITE_URL=https://amadoeamadojr.com.br
# Texto aleatório longo para anonimizar IPs nos limites de uso (gere com: openssl rand -hex 32):
# CRM_SAL_HASH=

# =============================================================================
# Uso local/administrativo (terminal) — nunca no navegador nem em arquivos versionados
# =============================================================================
# Criação do primeiro administrador (scripts/criar-admin.mjs):
# SUPABASE_URL=
# SUPABASE_SERVICE_ROLE_KEY=
# CRM_ADMIN_SENHA=            (opcional; se ausente, a senha é pedida no terminal)
#
# Testes E2E (npm run test:e2e) — conta administradora do ambiente de TESTE:
# E2E_ADMIN_EMAIL=
# E2E_ADMIN_SENHA=
# E2E_BASE_URL=http://localhost:3005
